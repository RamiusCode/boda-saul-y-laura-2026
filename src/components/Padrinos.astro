<!-- ═══════════════════════════════════════════════════════════ --><!-- 👔 SECCIÓN: PADRINOS                                        --><!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full py-4 sm:py-20 md:py-24 lg:py-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- 📇 CARD DE PADRINOS -->
        <div class="flex justify-center">
            <div class="relative w-full max-w-2xl" id="card-padrinos">
                <!-- BOTÓN DECORATIVO SUPERIOR -->
                <div
                    class="absolute z-20"
                    style="top: -30px; left: 50%; transform: translateX(-50%);"
                >
                    <div class="w-16 h-16" id="boton-decorativo-padrinos">
                        <img
                            src="/imagenes/boton.png"
                            alt="Decoración"
                            class="w-full h-full object-contain"
                        />
                    </div>
                </div>

                <!-- CARD PRINCIPAL -->
                <div
                    class="relative rounded-2xl shadow-xl overflow-hidden bg-[#f5f5f5]"
                    id="card-principal-padrinos"
                >
                    <!-- IMAGEN DE FONDO -->
                    <img
                        src="/imagenes/fondoplomo.png"
                        alt="Fondo padrinos"
                        class="absolute inset-0 w-full h-full object-cover"
                    />

                    <!-- Contenido de la card -->
                    <div
                        class="relative px-6 pt-16 pb-10 z-10"
                    >
                        <!-- TÍTULO PRINCIPAL -->
                        <div class="text-center mb-4">
                            <h2
                                class="font-great-vibes text-[2.25rem] leading-tight text-[#5E6B4A]"
                                id="titulo-padrinos"
                            >
                                Nuestros Padrinos
                            </h2>
                        </div>

                        <!-- 💌 MENSAJE DE AGRADECIMIENTO -->
                        <div
                            class="mt-6 md:mt-8 px-2 sm:px-6"
                            id="grid-padrinos"
                        >
                            <!-- ✦ Ornamento superior -->
                            <div
                                class="flex items-center justify-center gap-3 mb-6"
                                id="ornamento-sup-padrinos"
                            >
                                <div
                                    class="h-px w-16 sm:w-24 bg-gradient-to-r from-transparent to-[#5E6B4A]/40"
                                >
                                </div>
                                <span
                                    class="text-[#9a864a] text-sm leading-none"
                                    >✦</span
                                >
                                <div
                                    class="h-px w-16 sm:w-24 bg-gradient-to-l from-transparent to-[#5E6B4A]/40"
                                >
                                </div>
                            </div>

                            <p
                                class="font-crimson text-center text-[#5E6B4A] text-lg sm:text-xl leading-relaxed max-w-xl mx-auto"
                                id="mensaje-padrinos"
                            >
                                Gracias por ser testigos principales de nuestro
                                amor y por aceptar acompañarnos en este camino.
                                Saber que contamos con su cariño, su consejo
                                sincero y su bendición incondicional es la
                                certeza más hermosa con la que iniciamos este
                                nuevo capítulo de nuestras vidas.
                            </p>

                            <!-- ✦ Ornamento inferior -->
                            <div
                                class="flex items-center justify-center gap-3 mt-6"
                                id="ornamento-inf-padrinos"
                            >
                                <div
                                    class="h-px w-16 sm:w-24 bg-gradient-to-r from-transparent to-[#5E6B4A]/40"
                                >
                                </div>
                                <span
                                    class="text-[#9a864a] text-sm leading-none"
                                    >✦</span
                                >
                                <div
                                    class="h-px w-16 sm:w-24 bg-gradient-to-l from-transparent to-[#5E6B4A]/40"
                                >
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 🌿 RAMA SUPERIOR IZQUIERDA -->
                <img
                    src="/imagenes/floresverde.png"
                    alt=""
                    aria-hidden="true"
                    id="flor-izquierda-padrinos"
                    class="pointer-events-none select-none absolute w-[42%] sm:w-[38%] z-10"
                    style="top: -10%; left: -20%;"
                />

                <!-- 🌿 RAMA INFERIOR DERECHA (simetría de 180°) -->
                <img
                    src="/imagenes/floresverde.png"
                    alt=""
                    aria-hidden="true"
                    id="flor-derecha-padrinos"
                    class="pointer-events-none select-none absolute w-[42%] sm:w-[38%] z-10 rotate-180"
                    style="bottom: -10%; right: -20%;"
                />
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            // 🎯 ANIMACIÓN ELEGANTE DE ENTRADA
            const tl = gsap.timeline({
                scrollTrigger: {
                    trigger: "#card-padrinos",
                    start: "top 80%",
                    toggleActions: "play none none reset",
                },
            });

            // Botón decorativo
            tl.fromTo(
                "#boton-decorativo-padrinos",
                { opacity: 0, scale: 0, rotation: -180 },
                {
                    opacity: 1,
                    scale: 1,
                    rotation: 0,
                    duration: 1,
                    ease: "back.out(1.7)",
                },
                0,
            );

            // Card entra desde abajo
            tl.fromTo(
                "#card-principal-padrinos",
                {
                    opacity: 0,
                    y: 50,
                    scale: 0.95,
                },
                {
                    opacity: 1,
                    y: 0,
                    scale: 1,
                    duration: 1,
                    ease: "power3.out",
                },
                0,
            )
                // ✦ Título: desciende suave y se asienta
                .fromTo(
                    "#titulo-padrinos",
                    { opacity: 0, y: -28, scale: 0.94 },
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 1.4,
                        ease: "power3.out",
                    },
                    0.45,
                )
                // ✦ Ornamento superior: se abre desde el centro
                .fromTo(
                    "#ornamento-sup-padrinos",
                    { opacity: 0, scaleX: 0.4 },
                    {
                        opacity: 1,
                        scaleX: 1,
                        duration: 1.3,
                        ease: "power3.out",
                    },
                    0.7,
                )
                // 💌 Mensaje: sube con fade largo
                .fromTo(
                    "#mensaje-padrinos",
                    { opacity: 0, y: 22 },
                    {
                        opacity: 1,
                        y: 0,
                        duration: 1.4,
                        ease: "power3.out",
                    },
                    0.85,
                )
                // ✦ Ornamento inferior: cierra la secuencia
                .fromTo(
                    "#ornamento-inf-padrinos",
                    { opacity: 0, scaleX: 0.4 },
                    {
                        opacity: 1,
                        scaleX: 1,
                        duration: 1.3,
                        ease: "power3.out",
                    },
                    1.05,
                );

            // 🌿 RAMA IZQUIERDA: entra deslizándose desde la izquierda
            gsap.fromTo(
                "#flor-izquierda-padrinos",
                {
                    opacity: 0,
                    x: -90,
                    scale: 0.92,
                },
                {
                    opacity: 1,
                    x: 0,
                    scale: 1,
                    duration: 1.6,
                    delay: 0.35,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: "#card-padrinos",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            // 🌿 RAMA DERECHA: entra deslizándose desde la derecha
            // (rotation: 180 se mantiene fija para conservar la simetría)
            gsap.fromTo(
                "#flor-derecha-padrinos",
                {
                    opacity: 0,
                    x: 90,
                    scale: 0.92,
                    rotation: 180,
                },
                {
                    opacity: 1,
                    x: 0,
                    scale: 1,
                    rotation: 180,
                    duration: 1.6,
                    delay: 0.35,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: "#card-padrinos",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );
        });
    }
</script>
